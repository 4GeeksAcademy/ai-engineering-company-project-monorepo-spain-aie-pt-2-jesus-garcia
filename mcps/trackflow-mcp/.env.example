# ── Identidad del servidor MCP ───────────────────────────────────────────────
# URL pública exacta del endpoint MCP. Es el `resource` del PRM, el `aud` que
# valida mcpauth y el API Identifier configurado en Auth0 (incluye /mcp).
MCP_RESOURCE_URL=https://<codespace>-8001.app.github.dev/mcp

# Issuer OIDC del proveedor (Auth0 incluye la barra final).
MCP_AUTH_ISSUER=https://<tenant>.auth0.com/
MCP_AUTH_TYPE=oidc

# Scopes. El gate exige MCP_BASE_SCOPE y cada tool exige el suyo.
MCP_BASE_SCOPE=mcp:read
MCP_SCOPES_SUPPORTED=mcp:read,mcp:write
MCP_SHOW_ERROR_DETAILS=false

# ── Red ───────────────────────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8001
# Hosts permitidos por la protección anti DNS-rebinding. Incluye el host público
# de Codespaces y localhost para desarrollo.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,<codespace>-8001.app.github.dev
MCP_ALLOWED_ORIGINS=*
MCP_CORS_ORIGINS=*
# Solo para desarrollo local si el Host de prueba no está en la lista.
MCP_DISABLE_DNS_REBINDING_PROTECTION=false

# ── API de TrackFlow (servicio real) ─────────────────────────────────────────
TRACKFLOW_API_BASE_URL=http://localhost:8000
# Cuenta de servicio con rol manager. En producción crear un usuario dedicado.
TRACKFLOW_API_EMAIL=admin@trackflow.com
TRACKFLOW_API_PASSWORD=admin123
# Alternativa: token estático. Si se define, tiene prioridad sobre email/password.
TRACKFLOW_API_TOKEN=
TRACKFLOW_API_TIMEOUT_SECONDS=8

# ── Logs ─────────────────────────────────────────────────────────────────────
MCP_LOG_LEVEL=INFO
MCP_LOG_FORMAT=json

# ── Credenciales M2M solo para scripts de validación (no las usa el servidor) ─
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_M2M_AUDIENCE=
AUTH0_M2M_SCOPES=mcp:read
AUTH0_TOKEN_URL=https://<tenant>.auth0.com/oauth/token
