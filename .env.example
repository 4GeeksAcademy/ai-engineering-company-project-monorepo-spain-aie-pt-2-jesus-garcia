# TrackFlow — conjunto de variables para docker compose (template, sin secretos)
# Copiar a .env en la raíz y rellenar. .env está en .gitignore y no se commitea.

# Backend API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001
ENVIRONMENT=development
LOG_LEVEL=DEBUG
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Clave para firmar tokens JWT. OBLIGATORIA en producción (>= 32 caracteres).
# Generar con: openssl rand -base64 48
SECRET_KEY=
# Registro público de cuentas. En producción se desactiva por defecto.
ALLOW_PUBLIC_REGISTRATION=true
# Rate limiting en memoria (login, registro, agente, telemetría).
RATE_LIMIT_ENABLED=true
# UID/GID de los contenedores no-root (solo overlay hardened en Linux).
TRACKFLOW_UID=10001
TRACKFLOW_GID=10001
TRACKFLOW_UI_UID=1000
TRACKFLOW_UI_GID=1000

# Recuperación de contraseña
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# URL base del backoffice (puerto 3001 tras la contenedorización)
FRONTEND_URL=http://localhost:3001
# Email (Resend). VACÍO -> enlace por consola (stub dev). Con clave -> modo test.
RESEND_API_KEY=
# RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM="TrackFlow <onboarding@resend.dev>"

# Inventario (MILESTONE_5). Vacía -> engine = None, /inventory devuelve 500 explícito.
# Ver SUPABASE_SHARED_POOLER en services/api/.env.example para la URI del pooler.
DATABASE_URL=

# URLs entre servicios dentro de la red de Docker
# Server-side (backoffice): nombre de servicio de Docker
BACKEND_URL=http://services:8000
# Client-side (website): el navegador llama al host expuesto, no al nombre interno
NEXT_PUBLIC_API_URL=http://localhost:8000
# Base del backoffice (login) para el enlace "Iniciar Sesión" del website
NEXT_PUBLIC_BACKOFFICE_URL=http://localhost:3001

# Tareas asíncronas (Redis + Celery)
# En Docker el broker es el servicio `redis`; en local usa redis://localhost:6379/0.
REDIS_URL=redis://redis:6379/0
# Directorio compartido API/worker donde se guardan los CSV encolados.
# En Docker apunta al volumen `task-uploads`; en local, /tmp/trackflow/uploads.
INCIDENT_UPLOAD_DIR=/uploads
# Tamaño máximo del CSV de incidencias (MB).
INCIDENT_MAX_UPLOAD_MB=10
# Timeout duro y blando de cada intento de tarea (segundos).
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
# Base del backoff exponencial de reintentos: 5s, 10s, 20s.
CELERY_RETRY_BACKOFF_SECONDS=5
# Tiempo que el result backend conserva el resultado de cada tarea (segundos).
CELERY_RESULT_EXPIRES=86400

# Telemetría
# URL del colector leída por el backend (todavía sin uso en runtime)
TELEMETRY_ENDPOINT=
# Permite al colector aceptar eventos marcados como development/test (por defecto se descartan)
TELEMETRY_ALLOW_NON_PRODUCTION=
# Colector de telemetría para el frontend (relativo: el rewrite de Next lo proxya)
NEXT_PUBLIC_TELEMETRY_ENDPOINT=/api/telemetry/events
# Muestreo global de eventos de alta frecuencia (1.0 = 100%). Override en dev/pruebas.
NEXT_PUBLIC_TELEMETRY_SAMPLE_RATE=1.0
# Fuerza el envío de telemetría fuera de producción (por defecto: solo producción)
NEXT_PUBLIC_TELEMETRY_ENABLED=false

# Job nocturno (scripts/nightly_export.py + contenedor `scheduler`)
# Fecha objetivo del export (YYYY-MM-DD). Vacía -> ayer en UTC. Para pruebas manuales.
TARGET_DATE=
# Minutos tras los que una fila `processing` se considera huérfana y pasa a `failed`.
JOB_STALE_MINUTES=60
# Timeout del pipeline lanzado como subproceso por el job nocturno.
PIPELINE_TIMEOUT_SECONDS=1800
# URL (preferible de solo lectura) que usa el pipeline; fallback: DATABASE_URL.
DATABASE_URL_PIPELINE=

# RAG (MILESTONE 7) — las credenciales y modelos viven en services/api/.env.
# La API lo carga con load_dotenv() dentro del contenedor (bind mount /app).
# Ver services/api/.env.example: LLM_BASE_URL, LLM_API_KEY, EMBEDDING_MODEL,
# GENERATION_MODEL, QDRANT_URL, QDRANT_COLLECTION, RAG_MIN_SCORE.
# Audiencia del RAG: documentos que puede ver un usuario final (rol `user`).
RAG_PUBLIC_DOCUMENTS=sla-delivery,returns-policy
# Documentos comerciales/internos (solo manager/admin).
RAG_INTERNAL_DOCUMENTS=storage-pricing,carrier-coverage

# Recepción de RFPs (MILESTONE 9, Parte 1)
# Directorio runtime donde caen los PDF subidos y el Markdown convertido.
# Vacío -> <raíz del repo>/data/raw/rfp (en Docker: /app/data/raw/rfp).
RFP_RAW_DIR=
# Tamaño máximo aceptado por PDF (MB).
RFP_MAX_UPLOAD_MB=20
# Directorio de trazas JSON del grafo rfp_intake.
RFP_TRACE_DIR=
# Timeout de cada llamada al LLM de los agentes de recepción (segundos).
RFP_LLM_TIMEOUT_SECONDS=90

# MCP Server (mcps/trackflow-mcp) — OAuth resource server + tools.
# URL pública exacta del endpoint /mcp; es el resource del PRM y el audience.
MCP_RESOURCE_URL=https://<codespace>-8001.app.github.dev/mcp
MCP_AUTH_ISSUER=https://<tenant>.auth0.com/
MCP_AUTH_TYPE=oidc
MCP_BASE_SCOPE=mcp:read
MCP_SCOPES_SUPPORTED=mcp:read,mcp:write
MCP_SHOW_ERROR_DETAILS=false
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,<codespace>-8001.app.github.dev
MCP_ALLOWED_ORIGINS=https://www.mcpjam.com,https://mcpjam.com
MCP_CORS_ORIGINS=https://www.mcpjam.com,https://mcpjam.com
MCP_DISABLE_DNS_REBINDING_PROTECTION=false
TRACKFLOW_API_BASE_URL=http://localhost:8000
# Cuenta de servicio del MCP. Usa `seed_mcp_service.py` con MCP_SERVICE_PASSWORD
# para crearla; nunca reutilices admin123 en un entorno compartido.
TRACKFLOW_API_EMAIL=mcp-service@trackflow.com
TRACKFLOW_API_PASSWORD=
TRACKFLOW_API_TOKEN=
TRACKFLOW_API_TIMEOUT_SECONDS=8
MCP_LOG_LEVEL=INFO
MCP_LOG_FORMAT=json
# El agente dentro de `services` usa el nombre del servicio Docker.
MCP_SERVER_URL=http://mcp:8001/mcp
MCP_OAUTH_TOKEN_URL=https://<tenant>.auth0.com/oauth/token
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_AUDIENCE=https://<codespace>-8001.app.github.dev/mcp
MCP_OAUTH_SCOPES=mcp:read
AGENT_MCP_TIMEOUT_SECONDS=10

# Generación y evaluación de propuestas (MILESTONE 9, Parte 2)
# Iteraciones máximas del ciclo generador-evaluador por sección.
RFP_PROPOSAL_MAX_ITERATIONS=2
# Directorio de trazas JSON del grafo rfp_proposal.
RFP_PROPOSAL_TRACE_DIR=

# Aprobación humana y cierre (MILESTONE 9, Parte 3)
# Arranca las aprobaciones automáticamente al terminar la Parte 2 (1/0).
RFP_APPROVAL_AUTOSTART=1
# Rondas máximas de arbitraje/revisión por sección.
RFP_APPROVAL_MAX_ROUNDS=2
# Checkpointer durable: sqlite (por defecto) o memory (solo tests).
RFP_APPROVAL_CHECKPOINT_BACKEND=sqlite
# Vacío -> <raíz del repo>/data/runtime/rfp-approval/checkpoints.db.
RFP_APPROVAL_CHECKPOINT_DB=
# Directorio de trazas JSON de aprobación.
RFP_APPROVAL_TRACE_DIR=
