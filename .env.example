# TrackFlow — conjunto de variables para docker compose (template, sin secretos)
# Copiar a .env en la raíz y rellenar. .env está en .gitignore y no se commitea.

# Backend API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001
ENVIRONMENT=development
LOG_LEVEL=DEBUG
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Clave para firmar tokens JWT (generar una aleatoria en producción)
SECRET_KEY=change-this-to-a-random-secret-in-production

# Recuperación de contraseña
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# URL base del backoffice (puerto 3001 tras la contenedorización)
FRONTEND_URL=http://localhost:3001
# Email (Resend). VACÍO -> enlace por consola (stub dev). Con clave -> modo test.
RESEND_API_KEY=
# RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM="TrackFlow <onboarding@resend.dev>"

# Inventario (MILESTONE_5). Vacía -> engine = None, /inventory devuelve 500 explícito.
# Ver SUPABASE_SHARED_POOLER en services/api/.env.example para la URI del pooler.
DATABASE_URL=

# URLs entre servicios dentro de la red de Docker
# Server-side (backoffice): nombre de servicio de Docker
BACKEND_URL=http://services:8000
# Client-side (website): el navegador llama al host expuesto, no al nombre interno
NEXT_PUBLIC_API_URL=http://localhost:8000
# Base del backoffice (login) para el enlace "Iniciar Sesión" del website
NEXT_PUBLIC_BACKOFFICE_URL=http://localhost:3001

# Tareas asíncronas (Redis + Celery)
# En Docker el broker es el servicio `redis`; en local usa redis://localhost:6379/0.
REDIS_URL=redis://redis:6379/0
# Directorio compartido API/worker donde se guardan los CSV encolados.
# En Docker apunta al volumen `task-uploads`; en local, /tmp/trackflow/uploads.
INCIDENT_UPLOAD_DIR=/uploads
# Timeout duro y blando de cada intento de tarea (segundos).
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
# Base del backoff exponencial de reintentos: 5s, 10s, 20s.
CELERY_RETRY_BACKOFF_SECONDS=5
# Tiempo que el result backend conserva el resultado de cada tarea (segundos).
CELERY_RESULT_EXPIRES=86400

# Telemetría
# URL del colector leída por el backend (todavía sin uso en runtime)
TELEMETRY_ENDPOINT=
# Permite al colector aceptar eventos marcados como development/test (por defecto se descartan)
TELEMETRY_ALLOW_NON_PRODUCTION=
# Colector de telemetría para el frontend (relativo: el rewrite de Next lo proxya)
NEXT_PUBLIC_TELEMETRY_ENDPOINT=/api/telemetry/events
# Muestreo global de eventos de alta frecuencia (1.0 = 100%). Override en dev/pruebas.
NEXT_PUBLIC_TELEMETRY_SAMPLE_RATE=1.0
# Fuerza el envío de telemetría fuera de producción (por defecto: solo producción)
NEXT_PUBLIC_TELEMETRY_ENABLED=false

# Job nocturno (scripts/nightly_export.py + contenedor `scheduler`)
# Fecha objetivo del export (YYYY-MM-DD). Vacía -> ayer en UTC. Para pruebas manuales.
TARGET_DATE=
# Minutos tras los que una fila `processing` se considera huérfana y pasa a `failed`.
JOB_STALE_MINUTES=60
# Timeout del pipeline lanzado como subproceso por el job nocturno.
PIPELINE_TIMEOUT_SECONDS=1800
# URL (preferible de solo lectura) que usa el pipeline; fallback: DATABASE_URL.
DATABASE_URL_PIPELINE=

# RAG (MILESTONE 7) — las credenciales y modelos viven en services/api/.env.
# La API lo carga con load_dotenv() dentro del contenedor (bind mount /app).
# Ver services/api/.env.example: LLM_BASE_URL, LLM_API_KEY, EMBEDDING_MODEL,
# GENERATION_MODEL, QDRANT_URL, QDRANT_COLLECTION, RAG_MIN_SCORE.
