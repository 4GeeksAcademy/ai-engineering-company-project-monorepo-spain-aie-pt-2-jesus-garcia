# TrackFlow — conjunto de variables para docker compose (template, sin secretos)
# Copiar a .env en la raíz y rellenar. .env está en .gitignore y no se commitea.

# Backend API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001
ENVIRONMENT=development
LOG_LEVEL=DEBUG
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Clave para firmar tokens JWT (generar una aleatoria en producción)
SECRET_KEY=change-this-to-a-random-secret-in-production

# Recuperación de contraseña
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# URL base del backoffice (puerto 3001 tras la contenedorización)
FRONTEND_URL=http://localhost:3001
# Email (Resend). VACÍO -> enlace por consola (stub dev). Con clave -> modo test.
RESEND_API_KEY=
# RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM="TrackFlow <onboarding@resend.dev>"

# Inventario (MILESTONE_5). Vacía -> engine = None, /inventory devuelve 500 explícito.
# Ver SUPABASE_SHARED_POOLER en services/api/.env.example para la URI del pooler.
DATABASE_URL=

# URLs entre servicios dentro de la red de Docker
# Server-side (backoffice): nombre de servicio de Docker
BACKEND_URL=http://services:8000
# Client-side (website): el navegador llama al host expuesto, no al nombre interno
NEXT_PUBLIC_API_URL=http://localhost:8000
# Base del backoffice (login) para el enlace "Iniciar Sesión" del website
NEXT_PUBLIC_BACKOFFICE_URL=http://localhost:3001