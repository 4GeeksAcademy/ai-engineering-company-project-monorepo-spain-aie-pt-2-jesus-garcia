# TrackFlow Incidents API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001
# Conexión a Supabase (Transaction pooler, project-ref) — ver MILESTONE_5.md
SUPABASE_SHARED_POOLER=postgresql://postgres.[project-ref]:password@aws-0-region.pooler.supabase.com:6543/postgres
# DATABASE_URL usa la cadena anterior cuando hay base de datos SQL disponible
DATABASE_URL=
ENVIRONMENT=development
LOG_LEVEL=DEBUG
SECRET_KEY=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Recuperación de contraseña
# Duración del token de restablecimiento en minutos (rango recomendado 15-60)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# URL base del backoffice (puerto 3001 tras la contenedorización)
FRONTEND_URL=http://localhost:3001
# Email (Resend). VACÍO -> enlace por consola (stub dev). Con clave -> modo test
# (onboarding@resend.dev entrega solo a tu email verificado en resend.com).
RESEND_API_KEY=
# RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM="TrackFlow <onboarding@resend.dev>"

# Telemetría — URL del colector (leída por el backend; todavía sin uso en runtime)
TELEMETRY_ENDPOINT=
# Permite al colector aceptar eventos marcados como development/test (por defecto se descartan)
TELEMETRY_ALLOW_NON_PRODUCTION=

# RAG — Base de conocimiento (MILESTONE 7)
# Endpoint OpenAI-compatible del proxy LiteLLM de 4Geeks. Rellenar con la URL
# base que te haya dado el programa (p. ej. https://llm.4geeks.ai).
# El código tolera que acabe en `/`, `/v1` o `/litellm` y construye siempre
# `{base}/v1/{embeddings|chat/completions}` con una sola barra.
LLM_BASE_URL=https://llm.4geeks.ai
# API key del proxy LiteLLM (no commitear; services/api/.env está en .gitignore).
LLM_API_KEY=
# Modelo de embeddings dedicado. NO debe coincidir con GENERATION_MODEL.
# pplx-embed-v1-0.6b produce vectores de 1024 dimensiones.
# Si tu cohorte expone los IDs con prefijo `litellm/`, usa el ID completo
# (p. ej. litellm/madrid-spain/openrouter/perplexity/pplx-embed-v1-0.6b).
EMBEDDING_MODEL=madrid-spain/openrouter/perplexity/pplx-embed-v1-0.6b
# Modelo de generación (chat/completions).
GENERATION_MODEL=madrid-spain/openrouter/deepseek/deepseek-v4-flash
EMBEDDING_DIM=1024
# Qdrant. En local apunta al puerto publicado por docker compose; en Docker
# Compose el servicio `services` lo sobreescribe a http://qdrant:6333.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=trackflow_knowledge
RAG_TOP_K=5
RAG_MIN_SCORE=0.35

# Agente — tools en tiempo real (MILESTONE 8, parte 2; migradas a MCP)
# Variables legacy de las tools in-process; ya no intervienen en el camino MCP.
AGENT_INCIDENT_TOOL_TIMEOUT_SECONDS=3
AGENT_INVENTORY_TOOL_TIMEOUT_SECONDS=3
# Directorio de traces JSON del agente (vacío -> data/eval/agent-traces).
AGENT_TRACE_DIR=
# Las tools del agente se cargan desde el MCP Server (no hay llamada directa a
# la API ni a TinyDB/SQLModel). El agente obtiene un token OAuth propio con el
# grant configurado; nunca comparte el JWT local de TrackFlow con el MCP.
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_OAUTH_TOKEN_URL=https://<tenant>.auth0.com/oauth/token
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
# Auth0 usa `audience`; otros proveedores usan `resource` (RFC 8707).
MCP_OAUTH_AUDIENCE=https://<codespace>-8001.app.github.dev/mcp
MCP_OAUTH_RESOURCE=
MCP_OAUTH_SCOPES=mcp:read
MCP_OAUTH_GRANT_TYPE=client_credentials
MCP_OAUTH_REFRESH_TOKEN=
# Alternativa de desarrollo: token bearer estático (no usar en producción).
MCP_AGENT_BEARER_TOKEN=
# El handshake MCP + la llamada a la API necesitan más margen que una lectura
# local; si expira, el grafo devuelve un fallback honesto.
AGENT_MCP_TIMEOUT_SECONDS=10
MCP_OAUTH_TIMEOUT_SECONDS=5
